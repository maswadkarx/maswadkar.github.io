---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const entries = await getCollection('posts', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'posts'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.publishedAt,
  dateModified: entry.data.updatedAt ?? entry.data.publishedAt,
  author: { '@type': 'Person', '@id': `${profile.siteUrl}/#vivek`, name: profile.name },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site ?? profile.siteUrl).toString(),
  image: entry.data.cover ? new URL(entry.data.cover, Astro.site ?? profile.siteUrl).toString() : undefined,
  sameAs: entry.data.externalUrl,
};
const formatter = new Intl.DateTimeFormat('en', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover}
  type="article"
  publishedAt={entry.data.publishedAt}
  articleSchema={articleSchema}
>
  <article class="detail-page detail-page--article">
    <header class="detail-hero">
      <div class="detail-hero__inner" data-reveal>
        <p class="eyebrow">02 Thinking / Essay</p>
        <h1>{entry.data.title}</h1>
        <p class="detail-hero__description">{entry.data.description}</p>
        <p class="article-byline">
          {formatter.format(new Date(`${entry.data.publishedAt}T00:00:00`))}
          {entry.data.readingTime && <> · {entry.data.readingTime}</>}
        </p>
        {entry.data.externalUrl && (
          <div class="detail-actions">
            <a class="button button--coral" href={entry.data.externalUrl} target="_blank" rel="noopener noreferrer">
              {entry.data.externalLabel ?? 'Read the original'} <Icon name="ph:arrow-up-right" aria-hidden="true" />
            </a>
          </div>
        )}
      </div>
    </header>
    {entry.data.cover && (
      <figure class="detail-cover detail-cover--wide" data-reveal>
        <img src={entry.data.cover} alt={entry.data.coverAlt ?? ''} width="1536" height="864" />
      </figure>
    )}
    <div class="prose" data-reveal>
      <Content />
    </div>
    <nav class="detail-next" aria-label="Writing navigation">
      <a href="/writing/"><Icon name="ph:arrow-left" aria-hidden="true" /> Back to all writing</a>
      <a href="/contact/">Continue the conversation <Icon name="ph:arrow-right" aria-hidden="true" /></a>
    </nav>
  </article>
</BaseLayout>
